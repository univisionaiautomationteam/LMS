# ── Server configuration ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/lms

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of allowed origins (Vite dev server + prod frontend)
CORS_ORIGIN=http://localhost:5173

# Optional remote code runner (Piston or Judge0). Omit to disable the code lab.
# Piston example:  CODE_RUNNER_URL=https://emkc.org/api/v2/piston/execute
# Judge0 example:  CODE_RUNNER_URL=https://ce.judge0.com  CODE_RUNNER_TOKEN=your_token
CODE_RUNNER_URL=
CODE_RUNNER_TOKEN=

# ── File storage (AWS S3) ────────────────────────────────────────────
# Leave S3_BUCKET empty to store uploads on the API's own disk (./uploads).
# Setting S3_BUCKET switches storage to AWS S3 automatically.
#
# Required for S3:
#   S3_BUCKET              globally unique bucket name
#   AWS_REGION             bucket region, e.g. us-east-1
#   AWS_ACCESS_KEY_ID      IAM access key (needs s3:PutObject + s3:GetObject)
#   AWS_SECRET_ACCESS_KEY  IAM secret key
S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional overrides:
#   PUBLIC_API_URL        public base URL of this API (needed behind a proxy/CDN)
#   S3_PUBLIC_BASE_URL    set ONLY for a public bucket/CloudFront CDN; when unset
#                         downloads use short-lived presigned GET URLs (recommended)
# LOCAL_UPLOAD_DIR      where local-mode uploads land (default: ./uploads)
PUBLIC_API_URL=
S3_PUBLIC_BASE_URL=
LOCAL_UPLOAD_DIR=
